# 复制为 docker/.env 后按需修改，例如：cp docker/.env.example docker/.env

# 数据库密码（必填，web 与 db 服务共用）
DB_PASSWD=change-me-please

# 数据库名与账号
DB_NAME=tiebacloud
DB_USER=root

# 数据库主机（compose 内部固定为 db，一般无需修改）
DB_HOST=db
DB_SSL=0

# 对外访问端口
WEB_PORT=8080

# 容器内运行用户 UID/GID
PUID=1000
PGID=1000

# CSRF 防御开关
CSRF=true

# 是否自动创建 setup/install.lock（首次部署建议开启）
TC_AUTO_CREATE_INSTALL_LOCK=false

# 可选：只读 Gitee Token（UPDATE_GITEE_TOKEN），用于提高在线更新检查的 API 速率限制；
# 仅发送给 gitee.com，不要提交到 Git
# UPDATE_GITEE_TOKEN=
