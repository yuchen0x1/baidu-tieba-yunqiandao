{
    "name": "yuchen0x1/forum-auto-sign",
    "description": "百度贴吧云签到系统，持续正常更新",
    "type": "project",
    "license": "AGPL-3.0-only",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-openssl": "*",
        "ext-session": "*",
        "ext-zip": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "lint": "@php tools/lint.php",
        "security-scan": "@php tools/secret-scan.php",
        "integration": [
            "@php tools/migrate-integration-test.php",
            "@php tools/scheduler-integration-test.php",
            "@php tools/api-integration-test.php",
            "@php tools/backup-restore-drill.php",
            "@php tools/notification-integration-test.php"
        ],
        "gate": "@php tools/release-gate.php",
        "check": [
            "@lint",
            "@security-scan",
            "@test"
        ]
    }
}
